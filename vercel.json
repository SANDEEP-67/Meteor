{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend-meteor": {
      "root": "backend-meteor",
      "framework": "express"
    },
    "frontend-meteor": {
      "root": "frontend-meteor",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend-meteor" } },
    { "source": "/socket.io/(.*)", "destination": { "service": "backend-meteor" } },
    { "source": "/(.*)", "destination": { "service": "frontend-meteor" } }
  ]
}
